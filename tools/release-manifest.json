{
  "schemaVersion": 1,
  "rootFiles": [
    ".gitattributes",
    ".gitignore",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SECURITY.md",
    "VENDORED_SOURCES.json",
    "VERSION",
    "install-openai.ps1",
    "install.ps1",
    "install.sh",
    "setup-openai.cmd",
    "setup.cmd",
    "setup.ps1",
    "uninstall-openai.ps1",
    "uninstall.ps1",
    "uninstall.sh"
  ],
  "includeRoots": [
    ".github",
    "docs",
    "openai",
    "stack",
    "tests",
    "tools",
    "upstream"
  ],
  "excludePatterns": [
    "**/.git/**",
    "**/.tmp-*/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**",
    "**/work/**",
    "**/outputs/**",
    "**/.env",
    "**/.env.*",
    "**/auth.json",
    "**/receipt.json",
    "**/*.receipt.json",
    "**/install-journal.json",
    "**/events.jsonl",
    "**/*.log",
    "**/*.db",
    "**/*.db-wal",
    "**/*.db-shm",
    "**/*.sqlite",
    "**/*.sqlite-wal",
    "**/*.sqlite-shm",
    "**/*.sqlite3",
    "**/*.pem",
    "**/*.key",
    "**/*.pfx",
    "**/*.p12",
    "**/*.zip",
    "**/*.sha256",
    "**/*.exe",
    "**/*.dll",
    "**/*.node",
    "**/*.wasm",
    "**/*.bin",
    "**/*.ttf",
    "**/*.otf",
    "**/*.otb",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.pdf",
    "upstream/pxpipe/eval/grok-density/native-sweep/atlases",
    "upstream/pxpipe/eval/swe-bench/logs/**",
    "upstream/pxpipe/eval/deepswe/results/**",
    "upstream/pxpipe/eval/deepswe/results-retry/**",
    "upstream/pxpipe/eval/deepswe/results-retry2/**",
    "upstream/pxpipe/eval/deepswe/results-retry3/**",
    "upstream/pxpipe/eval/deepswe/failed-authexpiry/**"
  ]
}
